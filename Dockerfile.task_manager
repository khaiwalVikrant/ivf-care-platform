FROM python:3.11-slim

RUN pip install --no-cache-dir --upgrade pip setuptools wheel

WORKDIR /app

COPY pyproject.toml .
COPY task_manager/ task_manager/

RUN pip install --no-cache-dir \
    "fastapi>=0.110" \
    "uvicorn[standard]" \
    "sqlalchemy>=2.0" \
    "aiosqlite" \
    "pydantic==2.10.6" \
    "python-dotenv" \
    "asyncpg" \
    "python-jose[cryptography]" \
    "python-multipart" \
    "cloud-sql-python-connector[asyncpg]>=1.9.0" \
    "google-cloud-alloydb-connector[asyncpg]>=1.0.0" \
    "google-cloud-aiplatform>=1.38.0" \
    "vertexai"

ENV PORT=8080
EXPOSE 8080

CMD ["python", "-m", "task_manager.main"]
